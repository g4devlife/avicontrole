# ── Serveur ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SERVER_PUBLIC_URL=https://api.avicontrole.app

# ── Base de données ───────────────────────────────────────────
DATABASE_URL=postgresql://aviuser:MOT_DE_PASSE@localhost:5432/avicontrole

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=CHANGER_MOI_64_CHARS_ALEATOIRES
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Licences ──────────────────────────────────────────────────
LICENSE_HMAC_SECRET=CHANGER_MOI_AUTRE_SECRET_64_CHARS

# ── Prix EUR ──────────────────────────────────────────────────
PRICE_MONTHLY_EUR=2000

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff
TELEGRAM_WEBHOOK_SECRET=CHANGER_MOI_WEBHOOK_SECRET
TELEGRAM_ADMIN_IDS=123456789

# ── HD Wallet paiements on-chain ──────────────────────────────
# Générer UNE SEULE FOIS :
# node -e "const b=require('bip39');console.log(b.generateMnemonic(256))"
# SAUVEGARDER PRÉCIEUSEMENT — donne accès à tous les fonds reçus
HD_WALLET_MNEMONIC=mot1 mot2 mot3 mot4 mot5 mot6 mot7 mot8 mot9 mot10 mot11 mot12 mot13 mot14 mot15 mot16 mot17 mot18 mot19 mot20 mot21 mot22 mot23 mot24

# ── APK ───────────────────────────────────────────────────────
APK_DOWNLOAD_URL=https://api.avicontrole.app/download/avicontrole.apk
